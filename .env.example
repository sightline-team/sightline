# Sightline environment variables.
# Copy to .env to configure a mode. The app MUST run with no .env at all,
# in which case it uses fixtures mode (see docs/PRD.md R9 and AGENTS.md §4 rule 11).
# Never commit a real key. Nothing secret may start with NEXT_PUBLIC_.

# Mode B (relay) only. Leave empty to disable the relay entirely.
NEAR_AI_API_KEY=
RELAY_ENABLED=false
# Comma-separated list of TEE-hosted model ids the relay will forward. Empty = relay refuses all.
ALLOWED_MODELS=
RATE_LIMIT_PER_IP_PER_HOUR=20
# Shared store is required for a rate limit to mean anything on serverless.
# Empty = the relay refuses to start rather than rely on an in-memory counter.
RATE_LIMIT_STORE_URL=

NEXT_PUBLIC_NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# fixtures | relay | direct
NEXT_PUBLIC_DEFAULT_MODE=fixtures
# Mode A (the browser calls NEAR AI Cloud with the user's own key). Still false
# by default, and no longer because of CORS: the live preflight passed 2026-11-03
# and a page in Chromium completed the whole authenticated round trip on
# 2026-11-05 (SPIKE_RESULTS §6). It stays off because Settings has no key field
# yet (T-13, held by B-10 as a consent decision) and the attestation gate answers
# `failed` while /api/verify is a stub (B-12). Direct then falls back to fixtures
# automatically.
NEXT_PUBLIC_ALLOW_DIRECT=false
