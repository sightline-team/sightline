{
  "name": "sightline",
  "version": "0.1.0",
  "private": true,
  "description": "Private document explanation for blind and low-vision people, using attested AI on NEAR AI Cloud.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:fixtures": "NEXT_PUBLIC_DEFAULT_MODE=fixtures RELAY_ENABLED=false NEAR_AI_API_KEY= next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "spike": "tsx --env-file-if-exists=.env scripts/spike.ts",
    "fixtures:record": "tsx --env-file-if-exists=.env scripts/record-fixtures.ts",
    "golden": "tsx --env-file-if-exists=.env scripts/run-golden.ts",
    "crosscheck": "tsx --env-file-if-exists=.env scripts/crosscheck.ts",
    "roadmap:check": "tsx scripts/roadmap-check.ts"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
